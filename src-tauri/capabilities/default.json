{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Дозволи головного вікна",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "deep-link:default",
    "window-state:default",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
