{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lichtar",
  "version": "0.1.0",
  "identifier": "ua.lichtar.app",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Ліхтар", "width": 1100, "height": 700, "minWidth": 760, "minHeight": 560, "decorations": false }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["lichtar"] } }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Ukrainian"], "displayLanguageSelector": false }
    }
  }
}
